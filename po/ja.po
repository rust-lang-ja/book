msgstr "<span class=\"filename\">ファイル名: tests/common.rs</span>"

#: src/ch11-03-test-organization.md:249
msgid "// setup code specific to your library's tests would go here\n"
msgstr "// ここにライブラリテスト固有のコードが来る\n"

